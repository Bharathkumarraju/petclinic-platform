{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SecretsReadStagingWildcard",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecretVersionIds"
      ],
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:993533333148:secret:staging/*"
    },
    {
      "Sid": "EC2AndASGChanges",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:CreateTags",
        "ec2:CreateLaunchTemplateVersion",
        "ec2:ModifyLaunchTemplate",
        "autoscaling:StartInstanceRefresh"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3PermissionsForBackupsAndSwift",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:PutObject",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::abex-k8sbackup-bucket-staging-sin",
        "arn:aws:s3:::abex-k8sbackup-bucket-staging-sin/*",
        "arn:aws:s3:::abex-sftp-bucket-staging-sin/swift*",
        "arn:aws:s3:::abex-sftp-bucket-staging-sin/swift*/*",
        "arn:aws:s3:::abex-rds-backup-staging-sin",
        "arn:aws:s3:::abex-rds-backup-staging-sin/*"
      ]
    },
    {
      "Sid": "EKSPermissions",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks:ListClusters",
        "eks:UpdateClusterVersion"
      ],
      "Resource": "arn:aws:eks:ap-southeast-1:993533333148:cluster/abex-exch-aps1-staging-eks"
    },
    {
      "Sid": "KMSGenericForS3Etc",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*",
        "kms:DescribeKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsAccess",
      "Effect": "Allow",
      "Action": [
        "logs:PutRetentionPolicy",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams",
        "logs:DescribeLogGroups",
        "logs:CreateLogStream",
        "logs:CreateLogGroup"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:993533333148:log-group:*"
    },
    {
      "Sid": "RDSDescribeAndFailover",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances",
        "rds:FailoverDBCluster"
      ],
      "Resource": [
        "arn:aws:rds:ap-southeast-1:993533333148:cluster:*",
        "arn:aws:rds:ap-southeast-1:993533333148:db:*"
      ]
    },
    {
      "Sid": "SSMGetBottlerocketParams",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameter",
        "ssm:DescribeParameters"
      ],
      "Resource": "arn:aws:ssm:ap-southeast-1::parameter/aws/service/bottlerocket/*"
    },
    {
      "Sid": "RDSProxyDescribe",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBProxies",
        "rds:DescribeDBProxyEndpoints",
        "rds:DescribeDBProxyTargets",
        "rds:ListTagsForResource",
        "rds:DescribeDBInstances",
        "rds:DescribeDBClusters",
        "rds:DescribeDBClusterSnapshots",
        "rds:DescribeDBSnapshots",
        "rds:DescribeDBClusterSnapshotAttributes",
        "rds:DescribeDBSnapshotAttributes"
      ],
      "Resource": "arn:aws:rds:ap-southeast-1:993533333148:*:*"
    },
    {
      "Sid": "RDSDbConnectViaProxy",
      "Effect": "Allow",
      "Action": "rds-db:connect",
      "Resource": "arn:aws:rds-db:ap-southeast-1:993533333148:dbuser:*/*"
    },
    {
      "Sid": "SecretsReadAll",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:993533333148:secret:*"
    },
    {
      "Sid": "KMSDecryptForSecretsManager",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:ap-southeast-1:993533333148:key/687e0a87-87cd-418a-a5af-6bf231e3d4c6",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.ap-southeast-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "RDSSnapshotCRUD",
      "Effect": "Allow",
      "Action": [
        "rds:CopyDBClusterSnapshot",
        "rds:CopyDBSnapshot",
        "rds:CreateDBClusterSnapshot",
        "rds:CreateDBSnapshot",
        "rds:DeleteDBClusterSnapshot",
        "rds:DeleteDBSnapshot",
        "rds:ModifyDBClusterSnapshotAttribute",
        "rds:ModifyDBSnapshot",
        "rds:ModifyDBSnapshotAttribute"
      ],
      "Resource": "arn:aws:rds:ap-southeast-1:993533333148:cluster*"
    }
  ]
}
