{
    "Statement": [
        {
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Effect": "Allow",
            "Resource": "arn:aws:iam::${account_id}:role/svc-clara-finance-reports-${env}-sin",
            "Sid": "AllowAssumeRole"
        },
        {
            "Action": [
                "s3:PutObject",
                "s3:ListBucket",
                "s3:GetObject",
                "s3:GetObjectVersion"
            ],
            "Effect": "Allow",
            "Resource": ["arn:aws:s3:::abex-sftp-bucket-${env}-sin/*","arn:aws:s3:::abex-sftp-bucket-risk-${env}-sin/*"],
            "Sid": "AllowS3Access"
        },
        {
            "Action": "kms:GenerateDataKey",
            "Effect": "Allow",
            "Resource": "arn:aws:kms:ap-southeast-1:${account_id}:key/*",
            "Sid": "AllowGenerateDataKey"
        },
        {
            "Action": "kms:Decrypt",
            "Effect": "Allow",
            "Resource": "arn:aws:kms:ap-southeast-1:${account_id}:key/*",
            "Sid": "AllowDecryptKey"
        },
        {
            "Action": [
                "secretsmanager:GetSecretValue",
                "secretsmanager:DescribeSecret",
                "secretsmanager:ListSecrets"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:secretsmanager:ap-southeast-1:${account_id}:*"
            ],
            "Sid": "SecretsManagerAccess"
        },
        {
            "Action": [
                "kms:Decrypt"
            ],
            "Effect": "Allow",
            "Resource": "${kms_arn}",
            "Sid": "KMSDecryption"
        }
    ],
    "Version": "2012-10-17"
}