{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "s3:GetObject"
      ],
    "Effect": "Allow",
    "Resource": "*",
    "Sid": "LambdaReadfromS3"
    },
    {
      "Effect": "Allow",
      "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
      ],
      "Resource": [
          "*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
          "sns:Publish"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowKMSUsage",
      "Effect": "Allow",
      "Action": [
          "kms:GenerateDataKey*",
          "kms:Decrypt"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "AllowWritingToXrayForDebug",
      "Effect": "Allow",
      "Action": [
          "xray:PutTraceSegments",
          "xray:PutTelemetryRecords" 
      ],
      "Resource": [
        "*"
      ] 
    }


  ]
}