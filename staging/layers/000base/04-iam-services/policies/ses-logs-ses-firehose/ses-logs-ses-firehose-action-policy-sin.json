{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "firehose:PutRecordBatch"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:firehose:ap-southeast-1:${account_id}:deliverystream/*"
    },
    {
      "Sid": "AllowKMSUsage",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey"
      ],
      "Resource": [
        "arn:aws:kms:ap-southeast-1:993533333148:key/0397868f-b967-4531-99bb-59b331e37236"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
          "sns:Publish"
      ],
      "Resource": "*"
    }
  ]
}