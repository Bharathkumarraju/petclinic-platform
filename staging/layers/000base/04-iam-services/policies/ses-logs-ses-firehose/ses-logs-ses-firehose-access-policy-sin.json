{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AWSSESAssumeRole",
      "Effect": "Allow",
      "Principal": {
          "Service": "ses.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "${account_id}"
        }
      }
    }
  ]
}