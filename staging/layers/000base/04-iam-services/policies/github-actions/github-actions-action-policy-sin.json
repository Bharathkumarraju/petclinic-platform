{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecretVersionIds"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-southeast-1:${account_id}:secret:staging/*"
      ]
    },
    {
      "Sid": "EC2Permissions",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:CreateTags",
        "ec2:CreateLaunchTemplateVersion",
        "ec2:ModifyLaunchTemplate",
        "autoscaling:StartInstanceRefresh"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3Permissions",
      "Effect": "Allow",
      "Action": [
        "s3:ListAllMyBuckets",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:PutObjectAcl",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*"
      ],
      "Resource": [
        "arn:aws:s3:::abex-k8sbackup-bucket-staging-sin/*",
        "arn:aws:s3:::abex-k8sbackup-bucket-staging-sin",
        "arn:aws:s3:::abex-sftp-bucket-staging-sin/swift*/*",
        "arn:aws:s3:::abex-sftp-bucket-staging-sin/swift*",
        "arn:aws:s3:::abex-rds-backup-staging-sin",
        "arn:aws:s3:::abex-rds-backup-staging-sin/*"
      ]
    },
    {
      "Sid": "EKSClusterPermissions",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks:ListClusters",
        "eks:UpdateClusterVersion"
      ],
      "Resource": "arn:aws:eks:ap-southeast-1:${account_id}:cluster/abex-exch-aps1-staging-eks"
    },
    {
      "Sid": "AllowSecretsManagerandkmsAccess",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "*"
    },
    {
      "Action": [
        "logs:PutRetentionPolicy",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams",
        "logs:DescribeLogGroups",
        "logs:CreateLogStream",
        "logs:CreateLogGroup"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:logs:ap-southeast-1:${account_id}:log-group:*",
      "Sid": "AllowCloudWatchAccess"
    },
    {
      "Action": [
        "rds:DescribeDBClusters",
        "rds:DescribeDBInstances",
        "rds:FailoverDBCluster"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:rds:ap-southeast-1:${account_id}:cluster:*",
        "arn:aws:rds:ap-southeast-1:${account_id}:db:*"
      ],
      "Sid": "AllowRDSClusterAccess"
    },
    {
      "Sid": "SSMGetParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameter",
        "ssm:DescribeParameters"
      ],
      "Resource": "arn:aws:ssm:ap-southeast-1::parameter/aws/service/bottlerocket/*"
    }
  ]
}
